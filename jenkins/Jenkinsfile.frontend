pipeline {
    agent any
    
    environment {
        NODE_VERSION = '18'
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_USERNAME = credentials('docker-hub-username')
        DOCKER_PASSWORD = credentials('docker-hub-password')
        DOCKER_IMAGE = "${DOCKER_REGISTRY}/${DOCKER_USERNAME}/ticketnow-frontend"
        BUILD_NUMBER = "${env.BUILD_NUMBER}"
        GIT_COMMIT_SHORT = "${env.GIT_COMMIT.take(7)}"
        GIT_REPO = 'git@gitlab.com:fred4impact/mernstack-devops-showcase-project.git'
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "🔍 Checking out code..."
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                echo "🔒 Running frontend security audit..."
                dir('application/frontend') {
                    sh '''
                        npm audit --audit-level=high || echo "⚠️ High severity vulnerabilities found"
                        npm audit --audit-level=moderate || echo "⚠️ Moderate severity vulnerabilities found"
                    '''
                }
            }
        }
        
        stage('Build Frontend') {
            steps {
                echo "🏗️ Building frontend application..."
                dir('application/frontend') {
                    sh '''
                        npm ci --cache .npm --prefer-offline --no-audit
                        npm run build
                    '''
                }
            }
        }
        
        stage('Trivy Security Scan') {
            steps {
                echo "🔍 Running Trivy scan on frontend dependencies..."
                dir('application/frontend') {
                    sh '''
                        docker run --rm -v $(pwd):/workspace \
                            aquasec/trivy:latest fs /workspace \
                            --format table --exit-code 0
                    '''
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo "🐳 Building frontend Docker image..."
                dir('application/frontend') {
                    sh '''
                        docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                            -t ${DOCKER_IMAGE}:${GIT_COMMIT_SHORT} \
                            -t ${DOCKER_IMAGE}:latest .
                    '''
                }
            }
        }
        
        stage('Scan Docker Image') {
            steps {
                echo "🔍 Scanning frontend Docker image..."
                sh '''
                    docker run --rm aquasec/trivy:latest image \
                        ${DOCKER_IMAGE}:latest \
                        --format table --exit-code 0
                '''
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                echo "📤 Logging into Docker Hub..."
                sh '''
                    echo ${DOCKER_PASSWORD} | docker login -u ${DOCKER_USERNAME} --password-stdin
                '''
                
                echo "📤 Pushing frontend images..."
                sh '''
                    docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                    docker push ${DOCKER_IMAGE}:${GIT_COMMIT_SHORT}
                    docker push ${DOCKER_IMAGE}:latest
                '''
            }
        }
    }
    
    post {
        always {
            echo "🧹 Cleaning up..."
            sh '''
                docker system prune -f || true
                docker image prune -f || true
            '''
        }
        success {
            echo "✅ Frontend pipeline completed successfully!"
        }
        failure {
            echo "❌ Frontend pipeline failed!"
        }
    }
}
