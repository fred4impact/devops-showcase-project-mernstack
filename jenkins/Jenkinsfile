pipeline {
    agent any
    
    environment {
        NODE_VERSION = '18'
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_USERNAME = credentials('docker-hub-username')
        DOCKER_PASSWORD = credentials('docker-hub-password')
        DOCKER_IMAGE_BACKEND = "${DOCKER_REGISTRY}/${DOCKER_USERNAME}/ticketnow-backend"
        DOCKER_IMAGE_FRONTEND = "${DOCKER_REGISTRY}/${DOCKER_USERNAME}/ticketnow-frontend"
        BUILD_NUMBER = "${env.BUILD_NUMBER}"
        GIT_COMMIT_SHORT = "${env.GIT_COMMIT.take(7)}"
        GIT_REPO = 'git@gitlab.com:fred4impact/mernstack-devops-showcase-project.git'
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "🔍 Checking out code..."
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }
        
        stage('Security Scan') {
            parallel {
                stage('Backend Security') {
                    steps {
                        echo "🔒 Running backend security audit..."
                        dir('application/backend') {
                            sh '''
                                npm audit --audit-level=high || echo "⚠️ High severity vulnerabilities found"
                                npm audit --audit-level=moderate || echo "⚠️ Moderate severity vulnerabilities found"
                            '''
                        }
                    }
                }
                stage('Frontend Security') {
                    steps {
                        echo "🔒 Running frontend security audit..."
                        dir('application/frontend') {
                            sh '''
                                npm audit --audit-level=high || echo "⚠️ High severity vulnerabilities found"
                                npm audit --audit-level=moderate || echo "⚠️ Moderate severity vulnerabilities found"
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Build Applications') {
            parallel {
                stage('Build Backend') {
                    steps {
                        echo "🏗️ Building backend application..."
                        dir('application/backend') {
                            sh '''
                                npm ci --cache .npm --prefer-offline --no-audit
                                npm run build
                            '''
                        }
                    }
                }
                stage('Build Frontend') {
                    steps {
                        echo "🏗️ Building frontend application..."
                        dir('application/frontend') {
                            sh '''
                                npm ci --cache .npm --prefer-offline --no-audit
                                npm run build
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Trivy Security Scan') {
            parallel {
                stage('Scan Backend Dependencies') {
                    steps {
                        echo "🔍 Running Trivy scan on backend..."
                        dir('application/backend') {
                            sh '''
                                docker run --rm -v $(pwd):/workspace \
                                    aquasec/trivy:latest fs /workspace \
                                    --format table --exit-code 0
                            '''
                        }
                    }
                }
                stage('Scan Frontend Dependencies') {
                    steps {
                        echo "🔍 Running Trivy scan on frontend..."
                        dir('application/frontend') {
                            sh '''
                                docker run --rm -v $(pwd):/workspace \
                                    aquasec/trivy:latest fs /workspace \
                                    --format table --exit-code 0
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Build Docker Images') {
            parallel {
                stage('Build Backend Image') {
                    steps {
                        echo "🐳 Building backend Docker image..."
                        dir('application/backend') {
                            sh '''
                                docker build -t ${DOCKER_IMAGE_BACKEND}:${BUILD_NUMBER} \
                                    -t ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_IMAGE_BACKEND}:latest .
                            '''
                        }
                    }
                }
                stage('Build Frontend Image') {
                    steps {
                        echo "🐳 Building frontend Docker image..."
                        dir('application/frontend') {
                            sh '''
                                docker build -t ${DOCKER_IMAGE_FRONTEND}:${BUILD_NUMBER} \
                                    -t ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_IMAGE_FRONTEND}:latest .
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Scan Docker Images') {
            parallel {
                stage('Scan Backend Image') {
                    steps {
                        echo "🔍 Scanning backend Docker image..."
                        sh '''
                            docker run --rm aquasec/trivy:latest image \
                                ${DOCKER_IMAGE_BACKEND}:latest \
                                --format table --exit-code 0
                        '''
                    }
                }
                stage('Scan Frontend Image') {
                    steps {
                        echo "🔍 Scanning frontend Docker image..."
                        sh '''
                            docker run --rm aquasec/trivy:latest image \
                                ${DOCKER_IMAGE_FRONTEND}:latest \
                                --format table --exit-code 0
                        '''
                    }
                }
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                echo "📤 Logging into Docker Hub..."
                sh '''
                    echo ${DOCKER_PASSWORD} | docker login -u ${DOCKER_USERNAME} --password-stdin
                '''
                
                echo "📤 Pushing backend images..."
                sh '''
                    docker push ${DOCKER_IMAGE_BACKEND}:${BUILD_NUMBER}
                    docker push ${DOCKER_IMAGE_BACKEND}:${GIT_COMMIT_SHORT}
                    docker push ${DOCKER_IMAGE_BACKEND}:latest
                '''
                
                echo "📤 Pushing frontend images..."
                sh '''
                    docker push ${DOCKER_IMAGE_FRONTEND}:${BUILD_NUMBER}
                    docker push ${DOCKER_IMAGE_FRONTEND}:${GIT_COMMIT_SHORT}
                    docker push ${DOCKER_IMAGE_FRONTEND}:latest
                '''
            }
        }
    }
    
    post {
        always {
            echo "🧹 Cleaning up..."
            sh '''
                docker system prune -f || true
                docker image prune -f || true
            '''
        }
        success {
            echo "✅ Pipeline completed successfully!"
            // You can add notifications here (Slack, email, etc.)
        }
        failure {
            echo "❌ Pipeline failed!"
            // You can add failure notifications here
        }
    }
}
