{
  "name": "ticketnow-smoke-tests",
  "version": "1.0.0",
  "description": "Smoke tests for TicketNow MERN stack application",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:smoke": "jest --testNamePattern='smoke|Smoke'",
    "test:auth": "jest --testPathPattern=auth",
    "test:events": "jest --testPathPattern=events",
    "test:orders": "jest --testPathPattern=orders",
    "test:cart": "jest --testPathPattern=cart",
    "test:api": "jest --testPathPattern=api",
    "setup": "npm install && npm run test:setup",
    "test:setup": "node -e \"console.log('Test setup completed')\"",
    "clean": "rm -rf coverage node_modules/.cache",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^20.8.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.52.0",
    "jest": "^29.5.0",
    "puppeteer": "^21.5.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "testing",
    "smoke-tests",
    "mern",
    "ticketnow",
    "jest",
    "supertest"
  ],
  "author": "TicketNow Team",
  "license": "MIT"
}
